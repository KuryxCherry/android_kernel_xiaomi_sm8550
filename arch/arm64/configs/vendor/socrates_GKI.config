# Display
CONFIG_XIAOMI_DISP_NOTIFIER=m

# Fingerprint
CONFIG_FINGERPRINT_GOODIX_FOD=m
CONFIG_INPUT_FINGERPRINT=y

# IR
CONFIG_IR_SPI=m

# MTD
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m

# Power supply
CONFIG_MI_WIRELESS=y
CONFIG_WIRELESS_REVERSE_CLOSE=y

# Product
CONFIG_TARGET_PRODUCT_SOCRATES=y

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_THERMAL_MULTI_CHARGE=y

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_BRL=m
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m

# WL2866D regulator
CONFIG_REGULATOR_WL2866D=m

# Xiaomi HWID
CONFIG_MI_HARDWARE_ID=m

# CONFIG_QCOM_WCD_USBSS_I2C is not set

# =========================================================
# Custom Optimizations (Verified against bootable LineageOS config)
# =========================================================

# 1. Network: Enable TCP BBRv3 + FQ default qdisc (NET_SCH_FQ=y is already built-in)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR3=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_BBR3=y
CONFIG_DEFAULT_TCP_CONG="bbr3"
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_DEFAULT_NET_SCH="fq"

# 2. Memory & Power: Activate built-in MGLRU, RCU_LAZY, power-efficient workqueues, and LZ4/writeback ZRAM
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_RCU_LAZY_DEFAULT_OFF is not set
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_DEF_COMP="lz4"
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MEMORY_TRACKING=y

# 3. Filesystem & Network utilities (F2FS compression & CRYPTO_LZ4 are already built-in)
CONFIG_MQ_IOSCHED_ADIOS=y
CONFIG_MQ_IOSCHED_SSG=y
CONFIG_MQ_IOSCHED_SSG_CGROUP=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_TARGET_HL=y

# 4. Process Freezer / Tombstone: Built-in Re:Kernel (Generic Netlink)
CONFIG_REKERNEL=y
