# Display
CONFIG_XIAOMI_DISP_NOTIFIER=m

# Fingerprint
CONFIG_FINGERPRINT_GOODIX_FOD=m
CONFIG_INPUT_FINGERPRINT=y

# IR
CONFIG_IR_SPI=m

# MTD
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m

# Power supply
CONFIG_MI_WIRELESS=y
CONFIG_WIRELESS_REVERSE_CLOSE=y

# Product
CONFIG_TARGET_PRODUCT_SOCRATES=y

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_THERMAL_MULTI_CHARGE=y

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_BRL=m
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m

# WL2866D regulator
CONFIG_REGULATOR_WL2866D=m

# Xiaomi HWID
CONFIG_MI_HARDWARE_ID=m

# CONFIG_QCOM_WCD_USBSS_I2C is not set

# =========================================================
# Custom Optimizations (LineageOS / socrates)
# =========================================================

# 1. Network: Enable TCP BBR as default + FQ pacing
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y

# 2. Memory: Enable MGLRU by default + ZRAM default LZ4
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_CRYPTO_LZ4=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_DEF_COMP="lz4"

# 3. Filesystem & Network utilities (NTFS3, F2FS compression, TTL/HL)
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_TARGET_HL=y

# 4. Trim non-essential engineering debug options
#    (keep IPC_LOGGING & QCOM_DEBUG_SYMBOL for vendor module compatibility)
# CONFIG_KUNIT_DEBUGFS is not set
# CONFIG_QCOM_IOMMU_DEBUG is not set
# CONFIG_INTERCONNECT_QCOM_DEBUG is not set
# CONFIG_REGULATOR_DEBUG_CONTROL is not set
# CONFIG_SPMI_MSM_PMIC_ARB_DEBUG is not set
# CONFIG_QTI_BATTERY_GLINK_DEBUG is not set
# CONFIG_QTI_PMIC_GLINK_DEBUG is not set
# CONFIG_STM_SOURCE_FTRACE is not set
