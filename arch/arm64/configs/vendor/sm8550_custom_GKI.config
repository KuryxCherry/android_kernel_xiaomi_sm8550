# =========================================================
# Shared Custom Optimizations for Xiaomi SM8550 (LineageOS 24.0)
# Applied across socrates / fuxi / nuwa / vermeer after device_GKI.config
# =========================================================

# 1. Network: TCP BBRv3 + FQ default qdisc, TTL/HL targets
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR3=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_BBR3=y
CONFIG_DEFAULT_TCP_CONG="bbr3"
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_DEFAULT_NET_SCH="fq"
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_TARGET_HL=y

# 2. Memory & Power: MGLRU, RCU_LAZY, power-efficient workqueues, LZ4/writeback ZRAM
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_RCU_LAZY_DEFAULT_OFF is not set
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_DEF_COMP="lz4"
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MEMORY_TRACKING=y

# 3. Storage & Filesystems: SSG (with cgroup) + ADIOS I/O schedulers, direct boot defaults, NTFS3
CONFIG_MQ_IOSCHED_ADIOS=y
CONFIG_MQ_IOSCHED_SSG=y
CONFIG_MQ_IOSCHED_SSG_CGROUP=y
CONFIG_DEFAULT_IOSCHED="ssg"
CONFIG_DEFAULT_READ_AHEAD_KB=128
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y

# 4. Process Freezer / Tombstone: Built-in Re:Kernel (Generic Netlink)
CONFIG_REKERNEL=y
